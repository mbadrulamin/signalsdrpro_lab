options:
  parameters:
    id: lab12_fullduplex_tv
    title: Lab 12 - Full-Duplex DVB-T Video Link (TRANSMITS - contained environment only)
    author: SignalSDR Pro Lab
    description: Transmit a video file as DVB-T and receive it back on the same radio, simultaneously
    generate_options: qt_gui
    catch_exceptions: 'True'
    run: 'True'
    run_options: prompt
    run_command: '{python} -u {filename}'
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    window_size: (1900, 1050)
    sizing_mode: fixed
    placement: (0,0)
    category: '[GRC Hier Blocks]'
    comment: ''
    copyright: ''
    gen_cmake: 'On'
    cmake_opt: ''
    gen_linking: dynamic
    hier_block_src_path: '.:'
    output_language: python
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: note_legal
  id: note
  parameters:
    note: 'THIS TRANSMITS. DVB-T occupies 8 MHz of licensed broadcast spectrum. Faraday cage, or cable plus 40-60 dB
      attenuator. Never into an antenna on an active TV channel. Scan first: 03_scripts/scan_tv_band.py'
    comment: Read the README safety section before raising either transmit slider.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 90
    rotation: 0
    state: enabled
- name: note_interlock
  id: note
  parameters:
    note: 'SAFETY INTERLOCK: tx_amplitude and tx_gain both start at 0. The flowgraph radiates nothing until you deliberately
      raise them. Check what is on the TX/RX port first.'
    comment: The inert defaults are the interlock, not an inconvenience.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 150
    rotation: 0
    state: enabled
- name: note_duplex
  id: note
  parameters:
    note: 'FULL DUPLEX on one SignalSDR Pro: transmit on TX/RX, receive on RX2, simultaneously. Both share one reference
      oscillator, so the receiver sees ZERO frequency offset - the easiest possible synchronisation, and an unrealistically
      kind one.'
    comment: A real receiver must hunt for the carrier. Here it never has to. See README.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 210
    rotation: 0
    state: enabled
- name: note_ts
  id: note
  parameters:
    note: "Feed it video:  03_scripts/make_video_ts.py ~/Downloads/Bintang.mp4 /tmp/bintang.ts --mode 16qam-2/3-1/32\n\
      For anything longer than one pass of the file, use continuous playout instead:\n  03_scripts/tv_playout.py ~/Downloads/Bintang.mp4\
      \ --standard dvbt --mode 16qam-2/3-1/32 --fifo /tmp/tv.fifo\nA looping .ts sends the PCR BACKWARD by the file's\
      \ length at every lap (measured -208.86 s)."
    comment: Without ffmpeg use 03_scripts/make_test_ts.py for a valid but pictureless stream.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 270
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    value: 64e6 / 7
    comment: 'DVB-T elementary rate for an 8 MHz channel: 9.142857 MSPS. Both directions run at this rate, so the USB
      link carries 2 x 9.14 MSPS x 8 bytes = 146 MB/s. USB 3.0 only.'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 10
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    value: '8192'
    comment: 8K mode.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 80
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    value: fft_len // 32
    comment: Guard interval 1/32 = 256 samples.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 150
    rotation: 0
    state: enabled
- name: occupied
  id: variable
  parameters:
    value: '6817'
    comment: Transmitted carriers.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 220
    rotation: 0
    state: enabled
- name: payload
  id: variable
  parameters:
    value: '6048'
    comment: Data cells per symbol.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 290
    rotation: 0
    state: enabled
- name: ts_in
  id: variable
  parameters:
    value: '''/tmp/bintang.ts'''
    comment: Transport stream to transmit. MUST be muxed at exactly 16.086 Mbit/s for this mode. A file is right for
      the byte-exact verification in the README, because you need something to compare against; for sustained viewing
      use tv_playout.py and point this at its FIFO, or the clock restarts every lap.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 360
    rotation: 0
    state: enabled
- name: ts_out
  id: variable
  parameters:
    value: '''/tmp/lab12_rx.ts'''
    comment: Received stream is recorded here.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 430
    rotation: 0
    state: enabled
- name: play_video
  id: variable
  parameters:
    value: 'True'
    comment: Spawn ffplay on the received stream.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 500
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    value: 474e6 + 8e6 * (channel - 21)
    comment: Same 8 MHz UHF raster as Lab 11. Transmit and receive on the same channel.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 10
    rotation: 0
    state: enabled
- name: channel
  id: variable_qtgui_range
  parameters:
    gui_hint: 0,0,1,1
    label: '"UHF channel"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '21'
    step: '1'
    stop: '48'
    value: '31'
    widget: counter_slider
    comment: Both ends retune together - they are the same radio.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 80
    rotation: 0
    state: enabled
- name: tx_amplitude
  id: variable_qtgui_range
  parameters:
    gui_hint: 0,1,1,1
    label: '"TX amplitude (0 = off)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '1.0'
    value: '0'
    widget: counter_slider
    comment: Digital amplitude BEFORE the DAC. Starts at 0. At 1.0 the waveform has RMS 0.21 and peak 0.81 - deliberately
      backed off, because OFDM has 11 dB of peak-to-average ratio and clipping the peaks splatters into the neighbouring
      channels.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 150
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    gui_hint: 0,2,1,1
    label: '"TX gain (dB)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: '0'
    widget: counter_slider
    comment: Analog transmit gain in dB. Starts at 0. Raise this LAST, and only as far as the receiver needs. Over a
      short cable, 0 dB is usually already too much.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 220
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    gui_hint: 0,3,1,1
    label: '"RX gain (dB)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: '20'
    widget: counter_slider
    comment: Receive gain in dB. With the transmitter a few metres away this wants to be LOW - the usual failure here
      is overload, not weak signal.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 290
    rotation: 0
    state: enabled
- name: ts_src
  id: blocks_file_source
  parameters:
    repeat: 'True'
    vlen: '1'
    begin_tag: pmt.PMT_NIL
    offset: '0'
    length: '0'
    comment: The transport stream, looping forever. The modulator pulls bytes at exactly the rate the mode defines, so
      this file is a queue the hardware drains - not a clock.
    file: ts_in
    type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 620
    rotation: 0
    state: enabled
- name: tx_energy
  id: dtv_dvbt_energy_dispersal
  parameters:
    nsize: '1'
    comment: XOR with a PRBS so a static picture cannot put a spectral line in the middle of the channel.
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 260
    - 620
    rotation: 0
    state: enabled
- name: tx_rs
  id: dtv_dvbt_reed_solomon_enc
  parameters:
    p: '2'
    m: '8'
    gfpoly: '0x11d'
    n: '255'
    k: '239'
    t: '8'
    s: '51'
    blocks: '8'
    comment: 'RS(204,188): 16 parity bytes per packet, correcting up to 8 wrong bytes.'
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 510
    - 620
    rotation: 0
    state: enabled
- name: tx_ci
  id: dtv_dvbt_convolutional_interleaver
  parameters:
    blocks: '136'
    I: '12'
    M: '17'
    comment: Spreads each packet over 12 branches so an impulse hits many RS blocks slightly instead of one block fatally.
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 760
    - 620
    rotation: 0
    state: enabled
- name: tx_inner
  id: dtv_dvbt_inner_coder
  parameters:
    ninput: '1'
    noutput: payload
    comment: Rate 2/3 punctured convolutional code - the main error protection.
    constellation: 16qam
    hierarchy: nh
    code_rate: C2_3
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 750
    rotation: 0
    state: enabled
- name: tx_bi
  id: dtv_dvbt_bit_inner_interleaver
  parameters:
    comment: 'Decorrelates bit positions within each QAM symbol: the outer bits of a 16QAM point are much more reliable
      than the inner ones, and this shares that unfairness out.'
    transmission_mode: T8k
    constellation: 16qam
    hierarchy: nh
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 260
    - 750
    rotation: 0
    state: enabled
- name: tx_si
  id: dtv_dvbt_symbol_inner_interleaver
  parameters:
    comment: Scatters adjacent bits across all 6048 carriers, so a notch from a reflection removes isolated bits the
      Viterbi decoder can repair rather than a contiguous run it cannot.
    transmission_mode: T8k
    direction: Interleave
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 510
    - 750
    rotation: 0
    state: enabled
- name: tx_map
  id: dtv_dvbt_map
  parameters:
    gain: '1'
    comment: Bits to 16QAM constellation points.
    transmission_mode: T8k
    constellation: 16qam
    hierarchy: nh
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 760
    - 750
    rotation: 0
    state: enabled
- name: tx_pilots
  id: dtv_dvbt_reference_signals
  parameters:
    cell_id: '0'
    comment: 'Inserts scattered pilots, continual pilots and the TPS carriers - AND performs the IFFT. Its output is
      TIME domain. Adding an FFT block after it looks symmetrical with the receiver and silently destroys the signal:
      the OFDM timing still looks right to a cyclic-prefix detector, so the only symptom is that the frame synchroniser
      never locks.'
    type: complex
    transmission_mode: T8k
    constellation: 16qam
    hierarchy: nh
    code_rate_hp: C2_3
    code_rate_lp: C2_3
    guard_interval: GI_1_32
    include_cell_id: call_id_yes
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 880
    rotation: 0
    state: enabled
- name: tx_cp
  id: digital_ofdm_cyclic_prefixer
  parameters:
    input_size: fft_len
    cp_len: cp_len
    rolloff: '0'
    tagname: ''
    comment: Copies the last 256 samples to the front of each symbol. This is what turns a multipath channel into a simple
      per-carrier multiply at the receiver.
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 260
    - 880
    rotation: 0
    state: enabled
- name: tx_skip
  id: blocks_skiphead
  parameters:
    num_items: fft_len + cp_len
    vlen: '1'
    comment: Drop the first OFDM symbol. Measured, it carries a start-up transient with a peak of 8.1 against a steady-state
      RMS of 0.21 - a 31 dB spike where OFDM normally runs 11 dB. Sending it clips the DAC on the very first sample.
    type: complex
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 510
    - 880
    rotation: 0
    state: enabled
- name: tx_amp
  id: blocks_multiply_const_vxx
  parameters:
    const: tx_amplitude
    vlen: '1'
    comment: The interlock. 0 means nothing leaves the DAC.
    type: complex
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 760
    - 880
    rotation: 0
    state: enabled
- name: usrp_tx
  id: uhd_usrp_sink
  parameters:
    stream_chans: '[]'
    dev_addr: '"send_frame_size=8192,num_send_frames=256"'
    start_time: '-1.0'
    clock_rate: '0.0'
    num_mboards: '1'
    nchan: '1'
    samp_rate: samp_rate
    center_freq0: center_freq
    gain0: tx_gain
    bw0: samp_rate
    lo_source0: internal
    lo_export0: 'False'
    center_freq1: '0'
    gain1: '0'
    bw1: '0'
    lo_source1: internal
    lo_export1: 'False'
    center_freq2: '0'
    gain2: '0'
    bw2: '0'
    lo_source2: internal
    lo_export2: 'False'
    center_freq3: '0'
    gain3: '0'
    bw3: '0'
    lo_source3: internal
    lo_export3: 'False'
