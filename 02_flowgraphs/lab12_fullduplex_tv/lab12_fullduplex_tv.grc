    bw23: '0'
    lo_source23: internal
    lo_export23: 'False'
    center_freq24: '0'
    gain24: '0'
    bw24: '0'
    lo_source24: internal
    lo_export24: 'False'
    center_freq25: '0'
    gain25: '0'
    bw25: '0'
    lo_source25: internal
    lo_export25: 'False'
    center_freq26: '0'
    gain26: '0'
    bw26: '0'
    lo_source26: internal
    lo_export26: 'False'
    center_freq27: '0'
    gain27: '0'
    bw27: '0'
    lo_source27: internal
    lo_export27: 'False'
    center_freq28: '0'
    gain28: '0'
    bw28: '0'
    lo_source28: internal
    lo_export28: 'False'
    center_freq29: '0'
    gain29: '0'
    bw29: '0'
    lo_source29: internal
    lo_export29: 'False'
    center_freq30: '0'
    gain30: '0'
    bw30: '0'
    lo_source30: internal
    lo_export30: 'False'
    center_freq31: '0'
    gain31: '0'
    bw31: '0'
    lo_source31: internal
    lo_export31: 'False'
    show_lo_controls: 'False'
    len_tag_name: '""'
    comment: Transmit on the TX/RX port. bw0 = samp_rate keeps the analog reconstruction filter tight; without it the
      AD9361 leaves 56 MHz open and images land on other TV channels.
    type: fc32
    ant0: TX/RX
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 1010
    - 880
    rotation: 0
    state: enabled
- name: usrp_rx
  id: uhd_usrp_source
  parameters:
    stream_chans: '[]'
    dev_addr: '"num_recv_frames=512"'
    start_time: '-1.0'
    clock_rate: '0.0'
    num_mboards: '1'
    nchan: '1'
    samp_rate: samp_rate
    center_freq0: center_freq
    rx_agc0: Default
    gain0: rx_gain
    ant0: RX2
    bw0: samp_rate
    lo_source0: internal
    lo_export0: 'False'
    dc_offs0: 0+0j
    iq_imbal0: 0+0j
    center_freq1: '0'
