options:
  parameters:
    id: lab03_advanced_wbfm
    title: 'Lab 03 - Advanced WBFM with AGC, Squelch, Volume (SignalSDR Pro)'
    author: 'SignalSDR Pro Lab'
    description: 'Production-quality FM receiver with filtering, AGC, squelch, volume'
    generate_options: qt_gui
    catch_exceptions: 'True'
    run: 'True'
    run_options: prompt
    window_size: (1400, 900)
    sizing_mode: fixed
  states:
    coordinate: [10, 10]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '2000000'
  states:
    coordinate: [200, 10]
    rotation: 0
    state: enabled

- name: audio_rate
  id: variable
  parameters:
    value: '48000'
  states:
    coordinate: [340, 10]
    rotation: 0
    state: enabled

- name: quad_rate
  id: variable
  parameters:
    value: '384000'
  states:
    coordinate: [480, 10]
    rotation: 0
    state: enabled

- name: freq
  id: variable_qtgui_range
  parameters:
    label: 'FM Station (Hz)'
    rangeType: float
    start: '87.5e6'
    stop: '108e6'
    step: '100e3'
    value: '100.0e6'
    widget: counter_slider
    min_len: '200'
    orient: QtCore.Qt.Horizontal
  states:
    coordinate: [200, 100]
    rotation: 0
    state: enabled

- name: rf_gain
  id: variable_qtgui_range
  parameters:
    label: 'RF Gain (dB)'
    rangeType: float
    start: '0'
    stop: '76'
    step: '1'
    value: '40'
    widget: counter_slider
  states:
    coordinate: [500, 100]
    rotation: 0
    state: enabled

- name: squelch_threshold
  id: variable_qtgui_range
  parameters:
    label: 'Squelch (dB)'
    rangeType: float
    start: '-80'
    stop: '0'
    step: '1'
    value: '-50'
    widget: counter_slider
  states:
    coordinate: [200, 180]
    rotation: 0
    state: enabled

- name: volume
  id: variable_qtgui_range
  parameters:
    label: 'Volume'
    rangeType: float
    start: '0'
    stop: '5'
    step: '0.1'
    value: '1.0'
    widget: counter_slider
  states:
    coordinate: [500, 180]
    rotation: 0
    state: enabled

- name: usrp_source
  id: uhd_usrp_source
  parameters:
    type: fc32
    nchan: '1'
    num_mboards: '1'
    samp_rate: samp_rate
    sync: none
    ant0: '"TX/RX"'
    center_freq0: freq
    gain0: rf_gain
    gain_type0: default
  states:
    coordinate: [80, 320]
    rotation: 0
    state: enabled

- name: pre_filter
  id: low_pass_filter
  parameters:
    type: fir_filter_ccf
    decim: '1'
    gain: '1'
    samp_rate: samp_rate
    cutoff_freq: '100000'
    width: '20000'
    win: window.WIN_HAMMING
    beta: '6.76'
  states:
    coordinate: [300, 320]
    rotation: 0
    state: enabled

- name: freq_sink
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: '"Spectrum"'
    nconnections: '1'
    fftsize: '2048'
    fc: freq
    bw: samp_rate
    ymin: '-140'
    ymax: '10'
    update_time: '0.10'
    average: '0.5'
  states:
    coordinate: [300, 500]
    rotation: 0
    state: enabled

- name: waterfall_sink
  id: qtgui_waterfall_sink_x
  parameters:
    type: complex
    name: '"Waterfall"'
    nconnections: '1'
    fftsize: '2048'
    fc: freq
    bw: samp_rate
    update_time: '0.10'
  states:
    coordinate: [300, 700]
    rotation: 0
    state: enabled

- name: rational_resampler
  id: rational_resampler_xxx
  parameters:
    type: ccc
    interp: '24'
    decim: '125'
    taps: '[]'
    fbw: '0'
  states:
    coordinate: [520, 320]
    rotation: 0
    state: enabled

- name: agc
  id: analog_agc2_xx
  parameters:
    type: complex
    reference: '0.5'
    attack_rate: '0.01'
    decay_rate: '0.001'
    gain: '1.0'
    max_gain: '65536'
  states:
    coordinate: [740, 320]
    rotation: 0
    state: enabled

- name: squelch
  id: analog_pwr_squelch_xx
  parameters:
    type: complex
    threshold: squelch_threshold
    alpha: '0.01'
    ramp: '0'
    gate: 'False'
  states:
    coordinate: [960, 320]
    rotation: 0
    state: enabled

- name: wbfm_rcv
  id: analog_wfm_rcv
  parameters:
    quad_rate: quad_rate
    audio_decimation: '8'
  states:
    coordinate: [1180, 320]
    rotation: 0
    state: enabled

- name: volume_control
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: volume
    vlen: '1'
  states:
    coordinate: [1400, 320]
    rotation: 0
    state: enabled

- name: audio_sink
  id: audio_sink
  parameters:
    samp_rate: audio_rate
    device_name: '""'
    num_inputs: '1'
    ok_to_block: 'True'
  states:
    coordinate: [1620, 320]
    rotation: 0
    state: enabled

connections:
- [usrp_source, '0', pre_filter, '0']
- [pre_filter, '0', freq_sink, '0']
- [pre_filter, '0', waterfall_sink, '0']
- [pre_filter, '0', rational_resampler, '0']
- [rational_resampler, '0', agc, '0']
- [agc, '0', squelch, '0']
- [squelch, '0', wbfm_rcv, '0']
- [wbfm_rcv, '0', volume_control, '0']
- [volume_control, '0', audio_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
