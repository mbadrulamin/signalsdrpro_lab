    dc_offs30: 0+0j
    iq_imbal30: 0+0j
    center_freq31: '0'
    rx_agc31: Default
    gain31: '0'
    ant31: '"RX2"'
    bw31: '0'
    lo_source31: internal
    lo_export31: 'False'
    dc_offs31: 0+0j
    iq_imbal31: 0+0j
    show_lo_controls: 'False'
    comment: 'The radio. Note bw0 = samp_rate: without it the AD9361 keeps its 56 MHz default analog bandwidth and
      the neighbouring TV channels fold into this one.'
    type: fc32
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 300
    rotation: 0
    state: enabled
- name: acq
  id: dtv_dvbt_ofdm_sym_acquisition
  parameters:
    type: complex
    fft_length: fft_len
    occupied_tones: occupied
    cp_length: cp_len
    snr: '10'
    comment: Finds the OFDM symbol boundary by correlating the cyclic prefix against the end of the symbol, and
      corrects the fractional frequency offset. Everything downstream assumes this has locked.
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 460
    rotation: 0
    state: enabled
- name: ofdm_fft
  id: fft_vxx
  parameters:
    comment: Back to the frequency domain, where the pilots live. shift=True puts DC in the middle, which is what
      the pilot demodulator expects.
    type: complex
    fft_size: fft_len
    forward: 'True'
    window: window.rectangular(fft_len)
    shift: 'True'
    nthreads: '1'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 260
    - 460
    rotation: 0
    state: enabled
- name: pilots
  id: dtv_dvbt_demod_reference_signals
  parameters:
    cell_id: '0'
    comment: Uses the scattered and continual pilots to equalise every carrier, reads the TPS carriers to confirm
      the mode, and strips the pilots out. Outputs 6048 equalised data cells.
    type: complex
    transmission_mode: T8k
    constellation: 16qam
    hierarchy: nh
    code_rate_hp: C2_3
    code_rate_lp: C2_3
    guard_interval: GI_1_32
    include_cell_id: call_id_yes
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 510
    - 460
    rotation: 0
    state: enabled
- name: demap
  id: dtv_dvbt_demap
  parameters:
    gain: '1'
    comment: Constellation points back to bits.
    transmission_mode: T8k
    constellation: 16qam
    hierarchy: nh
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 760
    - 460
    rotation: 0
    state: enabled
- name: symdeint
  id: dtv_dvbt_symbol_inner_interleaver
  parameters:
    comment: 'Symbol DE-interleaver (direction = Deinterleave). Leaving this block out is the classic DVB-T receiver
      bug: the transport stream still gets a 0x47 on every packet, because the energy descrambler writes it unconditionally,
      while every payload byte is noise.'
    transmission_mode: T8k
    direction: Deinterleave
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 610
    rotation: 0
    state: enabled
- name: bitdeint
  id: dtv_dvbt_bit_inner_deinterleaver
  parameters:
    comment: Undoes the per-bit-position interleaving inside each QAM symbol.
    transmission_mode: T8k
    constellation: 16qam
    hierarchy: nh
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 260
    - 610
    rotation: 0
    state: enabled
- name: v2s
  id: blocks_vector_to_stream
  parameters:
    num_items: payload
    vlen: '1'
    comment: Vectors of 6048 soft bits become a byte stream for the Viterbi decoder.
    type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 510
    - 610
    rotation: 0
    state: enabled
- name: viterbi
  id: dtv_dvbt_viterbi_decoder
  parameters:
    comment: 'The inner convolutional decoder - the heaviest block in the chain. This is what sets the real-time
      limit: measured at 16.4 MSPS against the 9.14 MSPS needed, so 1.8x margin.'
    constellation: 16qam
    hierarchy: nh
    code_rate: C2_3
    type: b
    block_size: '768'
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 760
    - 610
    rotation: 0
    state: enabled
- name: convdeint
  id: dtv_dvbt_convolutional_deinterleaver
  parameters:
    blocks: '136'
    I: '12'
    M: '17'
    comment: Spreads each burst error across 12 Reed-Solomon blocks, so a fade that would destroy one packet instead
      puts a few correctable bytes into each of twelve.
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 10
    - 760
    rotation: 0
    state: enabled
- name: rs
  id: dtv_dvbt_reed_solomon_dec
  parameters:
    p: '2'
    m: '8'
    gfpoly: '0x11d'
    n: '255'
    k: '239'
    t: '8'
    s: '51'
    blocks: '8'
    comment: 'RS(204,188) over GF(2^8): corrects up to 8 wrong bytes per packet. If it gives up, the packet is lost
      - which is what the continuity counter then reveals.'
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 260
    - 760
    rotation: 0
    state: enabled
- name: descramble
  id: dtv_dvbt_energy_descramble
  parameters:
    nsize: '8'
    comment: Removes the PRBS that spread the spectrum, and restores the transport packet sync bytes.
    maxoutbuf: '0'
    minoutbuf: '0'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 510
    - 760
    rotation: 0
    state: enabled
- name: tv_out
  id: epy_block
  parameters:
    _source_code: "\"\"\"Transport-stream sink: statistics, an optional file, and live video.\n\nTwo things here\
      \ are deliberate and worth copying.\n\n**It never blocks the radio.**  Pointing a File Sink at a FIFO is the\
      \ obvious\nway to feed a player and it is a trap: if the player pauses or dies, the write\nblocks, the scheduler\
      \ stops draining the USRP, and the receiver drowns in\noverflows.  A bounded queue absorbs jitter and *drops*\
      \ when the player falls\nbehind.  Dropping television frames is the correct failure -- the radio keeps\nrunning\
      \ and the picture recovers at the next keyframe.\n\n**It counts continuity errors, not sync bytes.**  Every\
      \ packet leaving a DVB-T\nreceiver starts with 0x47 whether or not the decode worked, because the energy\n\
      descrambler writes that byte unconditionally.  The honest measure of link\nhealth is the continuity counter:\
      \ 4 bits per PID that increment on every\npacket, so a jump means Reed-Solomon gave up on a block.\n\"\"\"\
      \nimport queue\nimport subprocess\nimport threading\n\nimport numpy as np\nfrom gnuradio import gr\n\nPLAYER\
      \ = ['ffplay', '-hide_banner', '-loglevel', 'error', '-fflags', 'nobuffer',\n          '-flags', 'low_delay',\
      \ '-framedrop', '-autoexit',\n          '-window_title', 'SDR LAB TV', '-i', 'pipe:0']\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, play=True, ts_file='', report_every=20000):\n        gr.sync_block.__init__(self,\
      \ name='TV Output + TS Stats',\n                               in_sig=[np.uint8], out_sig=None)\n        self.set_output_multiple(188)\n\
      \        self.report_every = int(report_every)\n        self.packets = self.cc_errors = self.sync_errors =\
      \ self.dropped = 0\n        self.pids = {}\n        self._cc = {}\n        self._buf = b''\n        self._since\
      \ = 0\n        self._q = queue.Queue(maxsize=256)\n        self._fh = open(ts_file, 'wb') if ts_file else\
      \ None\n        self._proc = None\n        if play:\n            try:\n                self._proc = subprocess.Popen(PLAYER,\
      \ stdin=subprocess.PIPE,\n                                              stdout=subprocess.DEVNULL,\n     \
      \                                         stderr=subprocess.DEVNULL)\n            except FileNotFoundError:\n\
      \                print('[TV] ffplay not found -- install ffmpeg for live video '\n                      '(sudo\
      \ apt install ffmpeg). Recording only.')\n        threading.Thread(target=self._drain, daemon=True).start()\n\
      \n    def _drain(self):\n        while True:\n            chunk = self._q.get()\n            for sink in (self._proc.stdin\
      \ if self._proc else None, self._fh):\n                if sink is None:\n                    continue\n  \
      \              try:\n                    sink.write(chunk)\n                except (BrokenPipeError, ValueError,\
      \ OSError):\n                    pass\n\n    def work(self, input_items, output_items):\n        data = input_items[0].tobytes()\n\
      \        try:\n            self._q.put_nowait(data)\n        except queue.Full:\n            self.dropped\
      \ += 1\n        buf = self._buf + data\n        n = len(buf) // 188\n        for k in range(n):\n        \
      \    p = buf[k * 188:(k + 1) * 188]\n            self.packets += 1\n            self._since += 1\n       \
      \     if p[0] != 0x47:\n                self.sync_errors += 1\n                continue\n            pid =\
      \ ((p[1] & 0x1f) << 8) | p[2]\n            self.pids[pid] = self.pids.get(pid, 0) + 1\n            if pid\
      \ != 0x1fff and (p[3] & 0x10):\n                cc = p[3] & 0x0f\n                prev = self._cc.get(pid)\n\
      \                if prev is not None and cc != (prev + 1) % 16:\n                    self.cc_errors += 1\n\
      \                self._cc[pid] = cc\n        self._buf = buf[n * 188:]\n        if self._since >= self.report_every:\n\
      \            self._since = 0\n            self._report()\n        return len(input_items[0])\n\n    def _report(self):\n\
      \        top = sorted(self.pids.items(), key=lambda kv: -kv[1])[:6]\n        rate = self.cc_errors / max(1,\
      \ self.packets)\n        health = 'LOCKED  ' if rate < 1e-4 else ('marginal' if rate < 1e-2 else 'NO LOCK\
      \ ')\n        print(f'[TV] {health} {self.packets:>9,} pkts  '\n              f'CC err {self.cc_errors:>7,}\
      \ ({rate:.2e})  '\n              f'sync err {self.sync_errors:>6,}  dropped {self.dropped:>4}')\n        print('\
      \     PIDs: ' + '  '.join(\n            f'{p}{\"(null)\" if p == 8191 else \"\"}:{c*100.0/max(1,self.packets):.1f}%'\n\
      \            for p, c in top))\n"
    comment: 'Statistics, recording and live video in one block. Read its source: it explains why a File Sink on
      a FIFO would stall the radio, and why continuity errors - not sync bytes - are the measure of link health.'
    play: play_video
    ts_file: ts_file
    report_every: '20000'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 1030
    - 760
    rotation: 0
    state: enabled
