options:
  parameters:
    id: lab11_tv_receiver
    title: Lab 11 - DVB-T Television Receiver
    author: SignalSDR Pro Lab
    description: Receive a DVB-T channel, measure its quality, and watch the picture
    generate_options: qt_gui
    catch_exceptions: 'True'
    run: 'True'
    run_options: prompt
    run_command: '{python} -u {filename}'
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    window_size: (1800, 1000)
    sizing_mode: fixed
    placement: (0,0)
    category: '[GRC Hier Blocks]'
    comment: ''
    copyright: ''
    gen_cmake: 'On'
    cmake_opt: ''
    gen_linking: dynamic
    hier_block_src_path: '.:'
    output_language: python
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: note_what
  id: note
  parameters:
    note: DVB-T television receiver. Demodulates an 8 MHz terrestrial TV channel all the way to MPEG-2 transport
      stream, and hands it to ffplay for a live picture.
    comment: Start here. Read the README section "The chain, stage by stage" alongside this flowgraph.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 90
    rotation: 0
    state: enabled
- name: note_mode
  id: note
  parameters:
    note: 'MODE IS FIXED AT: 8K / 16QAM / CR 2/3 / GI 1/32  ->  16.086 Mbit/s. The transmitter MUST match all four.
      These are GRC enums, so changing mode means editing SIX blocks together.'
    comment: A mode mismatch does not produce an error message - it produces silence. Check this first.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 150
    rotation: 0
    state: enabled
- name: note_video
  id: note
  parameters:
    note: 'Live picture needs ffmpeg:   sudo apt install ffmpeg   Without it the flowgraph still runs, still measures,
      and still records the .ts file.'
    comment: Everything except the picture works with no external tools.
    alias: ''
    affinity: ''
  states:
    coordinate:
    - 10
    - 210
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    value: 64e6 / 7
    comment: 'DVB-T elementary rate for an 8 MHz channel: 64/7 = 9.142857 MSPS, one sample per elementary period
      T. Not negotiable - it defines the OFDM carrier spacing.'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 10
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    value: '8192'
    comment: '8K mode: 8192 carriers, of which 6817 are transmitted and 6048 carry data. Long symbols (896 us) survive
      long echoes - which is what lets a single-frequency network work.'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 90
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    value: fft_len // 32
    comment: Guard interval 1/32 = 256 samples = 28 us, so echoes up to 8.4 km of extra path are harmless.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 170
    rotation: 0
    state: enabled
- name: occupied
  id: variable
  parameters:
    value: '6817'
    comment: Transmitted carriers (Kmax-Kmin+1) in 8K mode.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 250
    rotation: 0
    state: enabled
- name: payload
  id: variable
  parameters:
    value: '6048'
    comment: Data cells per OFDM symbol, after pilots and TPS are removed.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 330
    rotation: 0
    state: enabled
- name: ts_file
  id: variable
  parameters:
    value: '''/tmp/lab11_rx.ts'''
    comment: Decoded transport stream is written here as well as played. Set to '' to disable recording.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 410
    rotation: 0
    state: enabled
- name: play_video
  id: variable
  parameters:
    value: 'True'
    comment: Spawn ffplay on the decoded stream. Set False to measure without a picture.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 330
    - 490
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    value: 474e6 + 8e6 * (channel - 21)
    comment: 'UHF channel plan used across Europe, Malaysia and most of Asia-Pacific: channel 21 is centred on 474
      MHz and every channel is 8 MHz wide.'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 10
    rotation: 0
    state: enabled
- name: channel
  id: variable_qtgui_range
  parameters:
    gui_hint: 0,0,1,1
    label: '"UHF channel"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '21'
    step: '1'
    stop: '48'
    value: '31'
    widget: counter_slider
    comment: Change channel. The USRP retunes immediately - this is the "seek" control. Channel 21-48 covers 470-694
      MHz, the band left to television after the 700 MHz clearance.
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 90
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    gui_hint: 0,1,1,1
    label: '"RX gain (dB)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: '45'
    widget: counter_slider
    comment: 'Receive gain in dB. Raise until MER stops improving, then stop: past that point you are amplifying
      the noise floor along with the signal.'
    affinity: ''
    alias: ''
  states:
    coordinate:
    - 560
    - 170
    rotation: 0
    state: enabled
- name: usrp
  id: uhd_usrp_source
  parameters:
    stream_chans: '[]'
    dev_addr: '"num_recv_frames=512"'
    start_time: '-1.0'
    clock_rate: '0.0'
    num_mboards: '1'
    nchan: '1'
    samp_rate: samp_rate
    center_freq0: center_freq
    rx_agc0: Default
    gain0: rx_gain
    ant0: RX2
    bw0: samp_rate
    lo_source0: internal
    lo_export0: 'False'
    dc_offs0: 0+0j
    iq_imbal0: 0+0j
    center_freq1: '0'
    rx_agc1: Default
    gain1: '0'
    ant1: '"RX2"'
    bw1: '0'
    lo_source1: internal
    lo_export1: 'False'
