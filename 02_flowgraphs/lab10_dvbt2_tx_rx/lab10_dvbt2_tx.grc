options:
  parameters:
    author: SignalSDR Pro Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Transmit a standards-compliant DVB-T2 multiplex for a real TV or
      tuner to receive
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: lab10_dvbt2_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Lab 10b - DVB-T2 Transmitter (RF - Faraday cage or dummy load ONLY)
    window_size: (1600, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 10]
    rotation: 0
    state: enabled

blocks:
- name: center_freq
  id: variable
  parameters:
    comment: UHF channel 21. PICK A CHANNEL THAT IS EMPTY WHERE YOU ARE, and only
      radiate inside a Faraday cage.
    value: 474e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 90]
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    comment: 'Guard interval 1/128 = 256 samples = 28 us. Short, because a 32K symbol
      is already 3.58 ms long: the guard is a fraction of the symbol, and 28 us still
      covers 8.4 km of echo.'
    value: fft_len // 128
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 10]
    rotation: 0
    state: enabled
- name: fec_blocks
  id: variable
  parameters:
    comment: 'LDPC blocks per T2 frame. This is what sets the payload rate: 202 x
      (43040 - 80) bits per 216.9 ms = 40.000738 Mbit/s.'
    value: '202'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1060, 10]
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    comment: FFT size. 32K is what real broadcasters use - UK Freeview HD and Malaysian
      MYTV both run 32K. Must match FFTSIZE_32K_T2GI in the five blocks that take
      it.
    value: '32768'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 10]
    rotation: 0
    state: enabled
- name: num_data_syms
  id: variable
  parameters:
    comment: Data symbols per T2 frame. With 1 P2 symbol that makes a frame of 2048
      + 60 x 33024 = 1,983,488 samples = 216.9 ms.
    value: '59'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [860, 10]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'The DVB-T2 elementary rate for an 8 MHz channel: 64/7 = 9.142857 MSPS.
      Not negotiable - it defines the OFDM carrier spacing.'
    value: (8000000.0 * 8) / 7
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 10]
    rotation: 0
    state: enabled
- name: ti_blocks
  id: variable
  parameters:
    comment: Time-interleaver blocks per frame.
    value: '3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 10]
    rotation: 0
    state: enabled
- name: ts_file
  id: variable
  parameters:
    comment: A named pipe fed by 03_scripts/tv_playout.py, not a file. Playout loops
      the VIDEO inside ffmpeg so the transport stream clock counts upwards forever.
      Looping a finished .ts instead sends the PCR backwards every lap, which a television
      shows as permanently sluggish playback.
    value: '''/tmp/tv.fifo'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 90]
    rotation: 0
    state: enabled
- name: tx_amplitude
  id: variable_qtgui_range
  parameters:
    comment: STARTS AT ZERO ON PURPOSE. Raise it deliberately once you have checked
      what is connected to the antenna port.
    gui_hint: ''
    label: '''TX digital amplitude'''
    min_len: '300'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.01'
    stop: '0.5'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 180]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    comment: Also starts at zero. In a cage or on a cable you need almost none of
      this.
    gui_hint: ''
    label: '''TX RF gain (dB)'''
    min_len: '300'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 180]
    rotation: 0
    state: enabled
- name: bbheader
  id: dtv_dvb_bbheader_bb
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 1 - Baseband framing. Slices the TS into BBFRAMEs and prepends
      a header saying how they are coded.
    fecblocks: '168'
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    inband: INBAND_OFF
    maxoutbuf: '0'
    minoutbuf: '0'
    mode: INPUTMODE_NORMAL
    rate1: C2_3
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    rolloff: RO_0_35
    standard: STANDARD_DVBT2
    tsrate: '4000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 400]
    rotation: 0
    state: enabled
- name: bbscrambler
  id: dtv_dvb_bbscrambler_bb
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 2 - Energy dispersal. XOR with a PRBS so a run of identical bytes
      does not produce a line spectrum.
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C2_3
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    standard: STANDARD_DVBT2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 400]
    rotation: 0
    state: enabled
- name: bch
  id: dtv_dvb_bch_bb
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 3 - BCH outer code. Mops up the residual errors the LDPC decoder
      leaves behind (its error floor).
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C2_3
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    standard: STANDARD_DVBT2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 400]
    rotation: 0
    state: enabled
- name: bitinterleaver
  id: dtv_dvbt2_interleaver_bb
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 5 - Bit interleaver. Spreads each LDPC codeword across constellation
      bits of differing reliability.
    constellation: MOD_256QAM
    framesize: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: C2_3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 400]
    rotation: 0
    state: enabled
- name: cellinterleaver
  id: dtv_dvbt2_cellinterleaver_cc
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 7 - Cell and TIME interleaving. Spreads one codeword over hundreds
      of ms so a burst of noise cannot kill it.
    constellation: MOD_256QAM
    fecblocks: fec_blocks
    framesize: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    tiblocks: ti_blocks
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1720, 400]
    rotation: 0
    state: enabled
- name: cyclic_prefixer
  id: digital_ofdm_cyclic_prefixer
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 11 - Copy the last 1/8 of each symbol to its front. This is what
      makes OFDM immune to multipath up to the guard length.
    cp_len: cp_len
    input_size: fft_len
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: '0'
    tagname: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 640]
    rotation: 0
    state: enabled
- name: framemapper
  id: dtv_dvbt2_framemapper_cc
  parameters:
    affinity: ''
    alias: ''
    carriermode: CARRIERS_EXTENDED
    comment: STAGE 8 - Build the T2 frame and the P2 symbols carrying L1 signalling,
      which tells the receiver how everything above was configured.
    constellation: MOD_256QAM
    fecblocks: fec_blocks
    fftsize1: FFTSIZE_32K_T2GI
    fftsize2: FFTSIZE_2K
    framesize: FECFRAME_NORMAL
    guardinterval: GI_1_128
    inband: INBAND_OFF
    inputmode: INPUTMODE_NORMAL
    l1constellation: L1_MOD_64QAM
    l1scrambled: L1_SCRAMBLED_OFF
    maxoutbuf: '0'
    minoutbuf: '0'
    numdatasyms: num_data_syms
    paprmode1: PAPR_OFF
    paprmode2: PAPR_OFF
    pilotpattern: PILOT_PP7
    preamble1: PREAMBLE_T2_SISO
    preamble2: PREAMBLE_T2_SISO
    rate: C2_3
    reservedbiasbits: RESERVED_OFF
    rotation: ROTATION_ON
    t2frames: '2'
    tiblocks: ti_blocks
    version: VERSION_111
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [60, 640]
    rotation: 0
    state: enabled
- name: freqinterleaver
  id: dtv_dvbt2_freqinterleaver_cc
  parameters:
    affinity: ''
    alias: ''
    carriermode: CARRIERS_EXTENDED
    comment: STAGE 9 - Frequency interleaver. Scatters cells across OFDM carriers
      so a notch in the channel does not wipe out consecutive data.
    fftsize: FFTSIZE_32K_T2GI
    guardinterval: GI_1_128
    maxoutbuf: '0'
    minoutbuf: '0'
    numdatasyms: num_data_syms
    paprmode1: PAPR_OFF
    paprmode2: PAPR_OFF
    pilotpattern: PILOT_PP7
    preamble1: PREAMBLE_T2_SISO
    preamble2: PREAMBLE_T2_SISO
    version: VERSION_111
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [340, 640]
    rotation: 0
    state: enabled
- name: ldpc
  id: dtv_dvb_ldpc_bb
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 4 - LDPC inner code, 64800-bit codewords. This is what gets DVB-T2
      within ~1 dB of the Shannon limit.
    constellation: MOD_OTHER
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C2_3
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    standard: STANDARD_DVBT2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 400]
    rotation: 0
    state: enabled
- name: modulator
  id: dtv_dvbt2_modulator_bc
  parameters:
    affinity: ''
    alias: ''
    comment: STAGE 6 - Map bits to constellation points. ROTATION_ON rotates the constellation
      so I and Q each carry full information.
    constellation: MOD_256QAM
    framesize: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rotation: ROTATION_ON
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1480, 400]
    rotation: 0
    state: enabled
- name: note_cfg
  id: note
  parameters:
    alias: ''
    comment: DVB-T2 parameters are GRC enums, so they cannot be driven from one variable.
    note: 'Config = official gr-dtv profile vv003-cr23: 32K extended, 256QAM, CR 2/3,
      GI 1/128, PP7

      -> 40.000738 Mbit/s. This is the mode UK Freeview HD and Malaysian MYTV broadcast.

      To change it you must edit TEN blocks together - see README.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 160]
    rotation: 0
    state: enabled
- name: note_legal
  id: note
  parameters:
    alias: ''
    comment: Read the README before running the RF version of this lab.
    note: THIS TRANSMITS. Faraday cage, or cable + attenuator into a dummy load. Never
      into an antenna.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 100]
    rotation: 0
    state: enabled
- name: note_video
  id: note
  parameters:
    alias: ''
    comment: A real television will list the service by the name in the SDT.
    note: "PLAYOUT FIRST, then start this flowgraph:\n  03_scripts/tv_playout.py ~/Downloads/Bintang.mp4\
      \ --standard dvbt2 --t2-fft 32k \\\n      --t2-guard 1/128 --t2-rate 2/3 --t2-fecblocks\
      \ 202 --t2-datasyms 59 \\\n      --video-bitrate 12000000 --fifo /tmp/tv.fifo\n\
      Do NOT point ts_file at a finished .ts with repeat=True: at every lap the PCR\
      \ jumps\nBACKWARD by the file's whole length and the picture goes sluggish.\
      \ Measured: -208.86 s."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 220]
    rotation: 0
    state: enabled
- name: p1insertion
  id: dtv_dvbt2_p1insertion_cc
  parameters:
    affinity: ''
    alias: ''
    carriermode: CARRIERS_EXTENDED
    comment: STAGE 12 - Prepend the P1 preamble symbol. A receiver finds this FIRST,
      by correlation, before it knows anything else.
    fftsize1: FFTSIZE_32K_T2GI
    fftsize2: FFTSIZE_2K
    guardinterval: GI_1_128
    maxoutbuf: '0'
    minoutbuf: '0'
    numdatasyms: num_data_syms
    preamble1: PREAMBLE_T2_SISO
    preamble2: PREAMBLE_T2_SISO
    showlevels: SHOWLEVELS_OFF
    vclip: '3.3'
    version: VERSION_111
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1180, 640]
    rotation: 0
    state: enabled
- name: pilotgenerator
  id: dtv_dvbt2_pilotgenerator_cc
  parameters:
    affinity: ''
    alias: ''
    bandwidth: BANDWIDTH_8_0_MHZ
    carriermode: CARRIERS_EXTENDED
    comment: STAGE 10 - Insert scattered/continual pilots, then IFFT. Output is a
      time-domain OFDM symbol. The pilots are what the receiver equalises against.
    equalization: EQUALIZATION_OFF
    fftsize: FFTSIZE_32K_T2GI
    guardinterval: GI_1_128
    maxoutbuf: '0'
    minoutbuf: '0'
    misogroup: MISO_TX1
    numdatasyms: num_data_syms
    paprmode1: PAPR_OFF
    paprmode2: PAPR_OFF
    pilotpattern: PILOT_PP7
    preamble1: PREAMBLE_T2_SISO
    preamble2: PREAMBLE_T2_SISO
    version: VERSION_111
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [620, 640]
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: OFDM looks like a rectangle, not a hump. The flat top IS the thousand-odd
      carriers.
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 0,0,1,1
    label: Relative Gain
    label1: ''
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '''DVB-T2 signal - should be a 7.6 MHz flat-topped block'''
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1460, 840]
    rotation: 0
    state: enabled
- name: timeplot
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: A sum of ~1000 independent carriers is Gaussian by the central limit
      theorem. That is why the PAPR is so high.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: 0,1,1,1
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '''Time domain - noise-like, with high peaks'''
    nconnections: '1'
    size: '2048'
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1740, 840]
    rotation: 0
    state: enabled
- name: ts_source
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: 'Reads the playout FIFO. repeat=False on purpose: a FIFO never reaches
      EOF while the writer lives, and if playout dies you want this to stop rather
      than spin on a rewind that cannot happen.'
    file: ts_file
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [60, 400]
    rotation: 0
    state: enabled
- name: tx_scale
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Amplitude control AND the smoothing reservoir: minoutbuf holds 4,194,304
      complex samples (about 0.46 s), which is two T2 frames. This is what turns a
      bursty producer into a continuous transmission.'
    const: tx_amplitude
    maxoutbuf: '0'
    minoutbuf: '4194304'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1460, 640]
    rotation: 0
    state: enabled
- name: usrp_sink
  id: uhd_usrp_sink
  parameters:
    affinity: ''
    alias: ''
    ant0: '''TX/RX'''
    ant1: '"TX/RX"'
    ant10: '"TX/RX"'
    ant11: '"TX/RX"'
    ant12: '"TX/RX"'
    ant13: '"TX/RX"'
    ant14: '"TX/RX"'
    ant15: '"TX/RX"'
    ant16: '"TX/RX"'
    ant17: '"TX/RX"'
    ant18: '"TX/RX"'
    ant19: '"TX/RX"'
    ant2: '"TX/RX"'
    ant20: '"TX/RX"'
    ant21: '"TX/RX"'
    ant22: '"TX/RX"'
    ant23: '"TX/RX"'
    ant24: '"TX/RX"'
    ant25: '"TX/RX"'
    ant26: '"TX/RX"'
    ant27: '"TX/RX"'
    ant28: '"TX/RX"'
    ant29: '"TX/RX"'
    ant3: '"TX/RX"'
    ant30: '"TX/RX"'
    ant31: '"TX/RX"'
    ant4: '"TX/RX"'
    ant5: '"TX/RX"'
    ant6: '"TX/RX"'
    ant7: '"TX/RX"'
    ant8: '"TX/RX"'
    ant9: '"TX/RX"'
    bw0: samp_rate
    bw1: '0'
    bw10: '0'
    bw11: '0'
    bw12: '0'
    bw13: '0'
    bw14: '0'
    bw15: '0'
    bw16: '0'
    bw17: '0'
    bw18: '0'
